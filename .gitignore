# executables that `alc build` / `alc run` write next to their source (no extension)
/examples/**/*
/tests/**/*
/tools/**/*
/bench/**/*
!/examples/**/
!/tests/**/
!/tools/**/
!/bench/**/
!/examples/**/*.*
!/tests/**/*.*
!/tools/**/*.*
!/bench/**/*.*
!/tests/one_target

# general rules last: they must win over the re-includes above
build/
tmp/
bench/bin/
__pycache__/
*.o
*.exe
*.test
*.pyc
