        return if w != w && got != got { 0 } else { 1000000 }
    }
    return ulps64(cast[u64](got), want)
}
fn report(name str, worst i64, bound i64, verbose bool) {
    if verbose {
        print(name, "worst error in ulp:", worst)
    } else {
        print(name, "within", bound, "ulp:", worst <= bound)
    }
}
