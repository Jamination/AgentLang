fn test_fmod(verbose bool) {
    worst := 0
    for i, a in a32_fmod {
        worst = max(worst, err32(fmod(cast[f32](a), cast[f32](b32_fmod[i])), e32_fmod[i]))
    }
    report("fmod f32", worst, 0, verbose)
    worst = 0
    for i, a in a64_fmod {
        worst = max(worst, err64(fmod(cast[f64](a), cast[f64](b64_fmod[i])), e64_fmod[i]))
    }
    report("fmod f64", worst, 0, verbose)
}
fn main() {
    verbose := false
    for a in args() {
        if a == "-v" {
            verbose = true
        }
    }
    test_sin(verbose)
    test_cos(verbose)
    test_tan(verbose)
    test_asin(verbose)
    test_acos(verbose)
    test_atan(verbose)
    test_exp(verbose)
    test_log(verbose)
    test_log2(verbose)
    test_atan2(verbose)
    test_pow(verbose)
    test_fmod(verbose)
}
