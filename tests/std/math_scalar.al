fn test_acos(verbose bool) {
    worst := 0
    for i, a in a32_acos {
        worst = max(worst, err32(acos(cast[f32](a)), e32_acos[i]))
    }
    report("acos f32", worst, 2, verbose)
    worst = 0
    for i, a in a64_acos {
        worst = max(worst, err64(acos(cast[f64](a)), e64_acos[i]))
    }
    report("acos f64", worst, 2, verbose)
}
