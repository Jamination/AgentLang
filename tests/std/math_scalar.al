// Generated by tests/gen/math_ref.py: do not edit.
// Scalar math functions against reference values from the C library (via Python).
fn ulps32(a u32, b u32) i64 {
    x := if a >> 31 != 0 { -i64(a & 0x7FFFFFFF) } else { i64(a) }
    y := if b >> 31 != 0 { -i64(b & 0x7FFFFFFF) } else { i64(b) }
    return abs(x - y)
}
fn ulps64(a u64, b u64) i64 {
    x := if a >> 63 != 0 { -i64(a & 0x7FFFFFFFFFFFFFFF) } else { i64(a) }
    y := if b >> 63 != 0 { -i64(b & 0x7FFFFFFFFFFFFFFF) } else { i64(b) }
    return abs(x - y)
}
// error of `got` against `want` in ulp; NaN must meet NaN
fn err32(got f32, want u32) i64 {
    w := cast[f32](want)
    if w != w || got != got {
        return if w != w && got != got { 0 } else { 1000000 }
    }
    return ulps32(cast[u32](got), want)
}
fn err64(got f64, want u64) i64 {
    w := cast[f64](want)
