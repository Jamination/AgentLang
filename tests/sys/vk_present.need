command -v weston >/dev/null && command -v timeout >/dev/null && test -n "$XDG_RUNTIME_DIR" && test -w "$XDG_RUNTIME_DIR" && test -e /usr/lib/libwayland-client.so.0 && { test -e /usr/lib/libvulkan.so.1 || test -e /usr/lib/x86_64-linux-gnu/libvulkan.so.1; } && for j in /usr/share/vulkan/icd.d/*.json /etc/vulkan/icd.d/*.json; do test -e "$j" || continue; lib=$(sed -n 's/.*"library_path" *: *"\([^"]*\)".*/\1/p' "$j"); for d in "" /usr/lib/ /usr/lib/x86_64-linux-gnu/; do test -n "$lib" && test -e "$d$lib" && exit 0; done; done; exit 1
