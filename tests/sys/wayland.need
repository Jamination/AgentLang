command -v weston >/dev/null && command -v timeout >/dev/null && test -n "$XDG_RUNTIME_DIR" && test -w "$XDG_RUNTIME_DIR" && for l in libwayland-client.so.0 libwayland-cursor.so.0 libxkbcommon.so.0; do test -e /usr/lib/$l || test -e /usr/lib64/$l || test -e /usr/lib/x86_64-linux-gnu/$l || exit 1; done
