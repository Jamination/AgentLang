// Generates the Windows calling convention test: abi.c (a DLL built with MinGW) and abi.al.
//   gen <dir>        writes <dir>/abi.c and <dir>/abi.al (run.sh does this in a scratch directory)
// Every function g<k> of the DLL hashes the bytes of its arguments into the exported variable
// `last_hash` and returns a value made from that hash; abi.al calls it and checks both. c<k>
// calls an AL function of the same signature with fixed arguments and checks its result the
// same way. The signatures (0 to 20 parameters) mix integers of every size, f32, f64 and
// structs of 1 to 64 bytes, as parameters and results.

struct Ty {
    al: str     // the AL type
    c: str      // the C type
    fields: []str // struct: the fields, each "alname:cdecl:kind:count" (kind i / u / f)
    size: i64
}

priv const N_SCALARS = 10

priv fn tys() -> Vec[Ty] {
    v := vec[Ty]()
    for s in []str{"i8:int8_t:1", "i16:int16_t:2", "i32:int32_t:4", "i64:int64_t:8", "u8:uint8_t:1", "u16:uint16_t:2", "u32:uint32_t:4", "u64:uint64_t:8", "f32:float:4", "f64:double:8"} {
        p := split(s, ':')
        n, _ := parse_i64(p[2])
        v.push(Ty{al: p[0], c: p[1], fields: nil, size: n})
    }
    // structs without padding: (name, fields "type count")
    for s in []str{"S1:u8 1", "S2:u8 2", "S3:u8 3", "S4:u16 2", "S4f:f32 1", "S5:u8 5", "S6:u16 3",
                   "S7:u8 7", "S8:i32 2", "S8f:f32 2", "S8d:f64 1", "S9:u8 9", "S12:i32 3", "S16:i64 2",
                   "S16d:f64 2", "S17:u8 17", "S20f:f32 5", "S24:i64 3", "S32:f64 4", "S33:u8 33", "S48:u64 6", "S64:i64 8"} {
        p := split(s, ':')
        q := split(p[1], ' ')
        cnt, _ := parse_i64(q[1])
        et := v[0]
        for t in v {
            if t.al == q[0] {
                et = t
            }
        }
        v.push(Ty{al: p[0], c: p[0], fields: []str{fmt(q[0], ":", et.c, ":", cnt)}, size: cnt * et.size})
    }
    return v
}

priv seed: u64 = 7

priv fn rnd(n: i64) -> i64 {
    seed = seed * 6364136223846793005 + 1442695040888963407
    return i64((seed >> 33) % u64(n))
}

// a literal of scalar type `t` as (AL text, C text)
priv fn lit(t: str) -> (str, str) {
    match t {
        "i8" => { x := rnd(256) - 128; return (fmt(x), fmt(x)) }
        "i16" => { x := rnd(65536) - 32768; return (fmt(x), fmt(x)) }
        "i32" => { x := rnd(1 << 32) - (1 << 31); return (fmt(x), fmt(x)) }
        "u8" => { x := rnd(256); return (fmt(x), fmt(x, "u")) }
        "u16" => { x := rnd(65536); return (fmt(x), fmt(x, "u")) }
        "u32" => { x := rnd(1 << 32); return (fmt(x), fmt(x, "u")) }
        "i64", "u64" => {
            x := (u64(rnd(1 << 31)) << 33) ^ u64(rnd(1 << 31)) ^ (u64(rnd(4)) << 62)
            return (fmt("0x", hex(x)), fmt("0x", hex(x), "ull"))
        }
        "f32" => { x := fmtf(f64(rnd(20001) - 10000) / 8.0, 3); return (x, fmt(x, "f")) }
        _ => { x := fmtf(f64(rnd(200001) - 100000) / 16.0, 4); return (x, x) }
    }
}

// a value of type ty: (AL expression, C initializer)
priv fn value(ty: Ty) -> (str, str) {
    if ty.fields.len == 0 {
        return lit(ty.al)
    }
    f := split(ty.fields[0], ':')
    n, _ := parse_i64(f[2])
    als := vec[str]()
    cs := vec[str]()
    for i in 0..n {
        a, c := lit(f[0])
        als.push(a)
        cs.push(c)
    }
    return (fmt(ty.al, "{[", n, "]", f[0], "{", join(als.items(), ", "), "}}"), fmt("{{", join(cs.items(), ", "), "}}"))
}

priv struct Sig {
    params: Vec[i64]
    ret: i64 // -1: none
}

fn main() {
    ts := tys()
    sigs := vec[Sig]()
    // all-of-a-kind signatures first, then random mixtures of 0 to 20 parameters
    for k in []i64{2, 3, 8, 9, 0, 13, 31} {
        p := vec[i64]()
        for i in 0..20 {
            p.push(if k == 31 { ts.len - 1 } else { k })
        }
        sigs.push(Sig{params: p, ret: k})
    }
    for n in 0..=20 {
        for r in 0..4 {
            p := vec[i64]()
            for i in 0..n {
                p.push(rnd(ts.len))
            }
            sigs.push(Sig{params: p, ret: rnd(ts.len + 2) - 2})
        }
    }
    c := vec[str]()
    al := vec[str]()
    c.push("// Generated by tests/winabi/gen.al: the DLL side of the Windows calling convention test.\n")
    c.push("#include <stdint.h>\n#include <string.h>\n#define EXPORT __declspec(dllexport)\n\n")
    c.push("EXPORT uint64_t last_hash;\nEXPORT int32_t counter = 100;\n\n")
    c.push("static uint64_t mix(uint64_t h, const void *p, size_t n) {\n    const uint8_t *b = p;\n    for (size_t i = 0; i < n; i++) h = (h ^ b[i]) * 1099511628211ull;\n    return h;\n}\n\n")
    c.push("static void fill(void *p, size_t n, uint64_t h) {\n    uint8_t *b = p;\n    for (size_t i = 0; i < n; i++) b[i] = (uint8_t)(h >> (8 * (i % 8))) ^ (uint8_t)(i / 8 * 37);\n}\n\n")
    c.push("EXPORT int32_t bump(void) { return ++counter; }\n\n")
    al.push("// Generated by tests/winabi/gen.al: the AL side of the Windows calling convention test.\n")
    al.push("extern \"abi.dll\" last_hash: u64\nextern \"abi.dll\" counter: i32\nextern \"abi.dll\" fn bump() -> i32\n\ncb_hash: u64\n\n")
    al.push("const H0: u64 = 14695981039346656037\n\n")
    al.push("fn mix[T](h: u64, p: *T) -> u64 {\n    b := cast[*u8](p)\n    for i in 0..sizeof[T]() {\n        h = (h ^ u64(b[i])) * 1099511628211\n    }\n    h\n}\n\n")
    al.push("fn fill[T](p: *T, h: u64) {\n    b := cast[*u8](p)\n    for i in 0..sizeof[T]() {\n        b[i] = u8(h >> u64(8 * (i % 8))) ^ u8(i / 8 * 37)\n    }\n}\n\n")
    for t in ts {
        if t.fields.len > 0 {
            f := split(t.fields[0], ':')
            c.push(fmt("typedef struct { ", f[1], " a[", f[2], "]; } ", t.c, ";\n"))
            al.push(fmt("struct ", t.al, " { a: [", f[2], "]", f[0], " }\n"))
        }
    }
    c.push("\n")
    al.push("\n")
    for k, s in sigs {
        rc := if s.ret < 0 { "void" } else { ts[s.ret].c }
        ra := if s.ret < 0 { "" } else { fmt(" -> ", ts[s.ret].al) }
        cps := vec[str]()
        aps := vec[str]()
        cts := vec[str]()
        ats := vec[str]()
        for i, p in s.params {
            cps.push(fmt(ts[p].c, " a", i))
            aps.push(fmt("a", i, ": ", ts[p].al))
            cts.push(ts[p].c)
            ats.push(ts[p].al)
        }
        cparams := if cps.len == 0 { "void" } else { join(cps.items(), ", ") }
        // the C function called from AL
        c.push(fmt("EXPORT ", rc, " g", k, "(", cparams, ") {\n    uint64_t h = 14695981039346656037ull;\n"))
        for i in 0..s.params.len {
            c.push(fmt("    h = mix(h, &a", i, ", sizeof a", i, ");\n"))
        }
        c.push("    last_hash = h;\n")
        if s.ret >= 0 {
            c.push(fmt("    ", rc, " r;\n    fill(&r, sizeof r, h);\n    return r;\n"))
        }
        c.push("}\n\n")
        // the C function that calls back into AL
        c.push(fmt("typedef ", rc, " (*cb", k, "_t)(", if cts.len == 0 { "void" } else { join(cts.items(), ", ") }, ");\n"))
        c.push(fmt("EXPORT int32_t c", k, "(cb", k, "_t cb) {\n    uint64_t h = 14695981039346656037ull;\n"))
        cargs := vec[str]()
        avals := vec[str]()
        for i, p in s.params {
            a, cv := value(ts[p])
            avals.push(a)
            c.push(fmt("    ", ts[p].c, " a", i, " = ", cv, ";\n    h = mix(h, &a", i, ", sizeof a", i, ");\n"))
            cargs.push(fmt("a", i))
        }
        c.push("    last_hash = h;\n")
        if s.ret >= 0 {
            c.push(fmt("    ", rc, " r = cb(", join(cargs.items(), ", "), "), e;\n    fill(&e, sizeof e, h);\n    return memcmp(&r, &e, sizeof r) == 0;\n}\n\n"))
        } else {
            c.push(fmt("    cb(", join(cargs.items(), ", "), ");\n    return 1;\n}\n\n"))
        }
        // AL: the declarations, the callback and the test
        al.push(fmt("extern \"abi.dll\" fn g", k, "(", join(aps.items(), ", "), ")", ra, "\n"))
        al.push(fmt("extern \"abi.dll\" fn c", k, "(cb: fn(", join(ats.items(), ", "), ")", ra, ") -> i32\n\n"))
        al.push(fmt("fn al", k, "(", join(aps.items(), ", "), ")", ra, " {\n    h := H0\n"))
        for i in 0..s.params.len {
            al.push(fmt("    h = mix(h, &a", i, ")\n"))
        }
        al.push("    cb_hash = h\n")
        if s.ret >= 0 {
            al.push(fmt("    r: ", ts[s.ret].al, "\n    fill(&r, h)\n    r\n"))
        }
        al.push("}\n\n")
        al.push(fmt("fn t", k, "() {\n"))
        for i, p in s.params {
            a, _ := value(ts[p])
            al.push(fmt("    a", i, ": ", ts[p].al, " = ", a, "\n"))
        }
        al.push("    last_hash = 0\n")
        names := vec[str]()
        for i in 0..s.params.len {
            names.push(fmt("a", i))
        }
        call := fmt("g", k, "(", join(names.items(), ", "), ")")
        al.push("    h := H0\n")
        for i in 0..s.params.len {
            al.push(fmt("    h = mix(h, &a", i, ")\n"))
        }
        if s.ret >= 0 {
            al.push(fmt("    r := ", call, "\n    e: ", ts[s.ret].al, "\n    fill(&e, h)\n    ok := last_hash == h && mix(H0, &r) == mix(H0, &e)\n"))
        } else {
            al.push(fmt("    ", call, "\n    ok := last_hash == h\n"))
        }
        al.push(fmt("    cb_hash = 1\n    ok2 := c", k, "(al", k, ") == 1 && cb_hash == last_hash\n"))
        al.push(fmt("    if !ok || !ok2 {\n        print(\"FAIL g", k, "(", join(ats.items(), ", "), ")", ra, ":\", ok, ok2)\n    }\n    passed += i64(ok) + i64(ok2)\n}\n\n"))
    }
    al.push("passed: i64\n\nfn main() -> i64 {\n")
    for k in 0..sigs.len {
        al.push(fmt("    t", k, "()\n"))
    }
    al.push("    // a variable of the DLL: read and written through its import slot, seen by the DLL's code\n")
    al.push("    c0 := counter\n    counter = 7\n    b := bump()\n    p: *i32 = &counter\n    data_ok := c0 == 100 && b == 8 && *p == 8\n")
    al.push(fmt("    print(\"passed\", passed, \"of\", ", 2 * sigs.len, ", \"data\", data_ok)\n"))
    al.push(fmt("    if passed == ", 2 * sigs.len, " && data_ok { 0 } else { 1 }\n}\n"))
    a := args()
    if a.len != 2 {
        panic("usage: gen <dir> (writes <dir>/abi.c and <dir>/abi.al)")
    }
    if !write_file(fmt(a[1], "/abi.c"), join(c.items(), "")) || !write_file(fmt(a[1], "/abi.al"), join(al.items(), "")) {
        panic(fmt("cannot write abi.c or abi.al in ", a[1]))
    }
    print(sigs.len, "signatures")
}
