const C: f32 = 1.00000005960464477539062500000001
const D = [2]f32{1.00000005960464477539062500000001, -1.00000005960464477539062500000001}
fn main() {
    x: f32 = 1.00000005960464477539062500000001
    y: f32 = 1.000000059604644775390625
    z: f32 = 1.00000005960464477539062499999
    w: f32 = 1.0000001788139343261718750000001
    v := vec2(1.00000005960464477539062500000001, 0.5)
    print(x, y, z, w, C, D, v, -x)
}
