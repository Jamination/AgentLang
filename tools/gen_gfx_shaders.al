// Compiles the shaders of std.gfx and writes them into std/gfx_shaders.al, so that a program
// that draws with std.gfx needs no shader compiler at run time. Run it on Windows from the
// root of the repository, then rebuild alc (the module is embedded in the compiler):
//
//     build\alc.exe run tools/gen_gfx_shaders.al
//
// tools/gfx/sprite.hlsl -> DXBC (shader model 5.0) with D3DCompile of d3dcompiler_47.dll, the
// compiler every Windows 10/11 has (the same as fxc.exe);
// tools/gfx/sprite.vert, sprite.frag -> SPIR-V with glslc of the Vulkan SDK (on the PATH, or
// %VULKAN_SDK%\Bin). The output is byte-identical when nothing changed.
use std.dx12
use std.os

const OUT = "std/gfx_shaders.al"
const TMP = "tmp/gfx_shaders"

priv fn fail(msg: str) -> never {
    eprint(concat("gen_gfx_shaders: ", msg))
    exit(1)
}

priv fn hlsl(source: str, entry: str, target: str) -> str {
    code: *ID3DBlob
    errors: *ID3DBlob
    hr := D3DCompile(ptr(source), u64(len(source)), ptr("tools/gfx/sprite.hlsl"), nil, nil, cstr(entry), cstr(target),
        D3DCOMPILE_ENABLE_STRICTNESS | D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors)
    if FAILED(hr) {
        fail(if errors != nil { clone(blob_bytes(errors)) } else { hresult_text("D3DCompile", hr) })
    }
    out := clone(blob_bytes(code))
    com_release(&code)
    com_release(&errors)
    out
}

priv fn glslc() -> str {
    sdk, ok := env_get("VULKAN_SDK")
    if ok && file_exists(fmt(sdk, "/Bin/glslc.exe")) { fmt(sdk, "/Bin/glslc.exe") } else { "glslc" }
}

priv fn spirv(path: str) -> str {
    out := fmt(TMP, "/", path_base(path), ".spv")
    if run([]str{glslc(), "--target-env=vulkan1.3", "-O", path, "-o", out}) != 0 {
        fail(fmt("glslc failed on ", path))
    }
    data, ok := read_file(out)
    if !ok { fail(fmt("cannot read ", out)) }
    data
}

// `const NAME = "..."`: the bytes as \x escapes, on one line.
priv fn constant(out: *Vec[u8], name: str, what: str, data: str) {
    out.extend(fmt("// ", what, ", ", len(data), " bytes\n"))
    out.extend(fmt("const ", name, " = \""))
    for b in data {
        out.extend("\\x")
        out.extend(hex(u64(b), 2))
    }
    out.extend("\"\n\n")
}

fn main() {
    src, ok := read_file("tools/gfx/sprite.hlsl")
    if !ok { fail("cannot read tools/gfx/sprite.hlsl (run it from the root of the repository)") }
    make_dir("tmp")
    make_dir(TMP)
    out := vec[u8]()
    out.extend("// GENERATED by tools/gen_gfx_shaders.al from tools/gfx/: do not edit. The shaders of std.gfx,\n")
    out.extend("// compiled ahead of time: DXBC for std/gfx_dx12.al, SPIR-V for std/gfx_vk.al. Internal names.\n\n")
    constant(&out, "__GFX_VS_DXBC", "sprite.hlsl vs_main, vs_5_0", hlsl(src, "vs_main", "vs_5_0"))
    constant(&out, "__GFX_PS_DXBC", "sprite.hlsl ps_main, ps_5_0", hlsl(src, "ps_main", "ps_5_0"))
    constant(&out, "__GFX_VERT_SPV", "sprite.vert, glslc --target-env=vulkan1.3 -O", spirv("tools/gfx/sprite.vert"))
    constant(&out, "__GFX_FRAG_SPV", "sprite.frag, glslc --target-env=vulkan1.3 -O", spirv("tools/gfx/sprite.frag"))
    text := out.items()
    trimmed := text[..len(text) - 1]          // one newline at the end
    if !write_file(OUT, trimmed) { fail(fmt("cannot write ", OUT)) }
    print("wrote", OUT, len(trimmed), "bytes")
}
