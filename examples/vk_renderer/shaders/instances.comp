#version 450
// Writes the instances of the frame: instance 0 is the near quad (it moves when `animate` is
// set), instance 1 the far one, yellow on even frames and cyan on odd ones (when animating:
// every 64 frames, so that a window does not flicker).
layout(local_size_x = 64) in;

struct Instance {
    vec4 offset_scale;
    vec4 tint;
};
layout(set = 0, binding = 0, std430) writeonly buffer Instances { Instance inst[]; };

layout(push_constant) uniform Push {
    uint frame;
    uint count;
    uint animate;
    float seconds;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    if (i == 0u) {
        float dx = pc.animate != 0u ? 0.3 * sin(pc.seconds * 2.0) : 0.0;
        inst[i].offset_scale = vec4(-0.2 + dx, -0.2, 0.4, 0.5);
        inst[i].tint = vec4(1.0);
    } else {
        inst[i].offset_scale = vec4(0.3, 0.3, 0.6, 0.4);
        uint phase = pc.animate != 0u ? pc.frame >> 6 : pc.frame;
        inst[i].tint = (phase & 1u) == 0u ? vec4(1.0, 1.0, 0.0, 1.0) : vec4(0.0, 1.0, 1.0, 1.0);
    }
}
